# Copy to .env and fill in. Never commit .env.

# ── Bots ──────────────────────────────────────────────────────
DISCORD_TOKEN=
TELEGRAM_TOKEN=

# Voice mode only (product_inference/bot_audio.py) — consumes Sarvam credits.
SARVAM_API_KEY=

# Vercel status endpoint only.
HEALTHCHECKS_API=

# ── Web chat surface (product_inference/web) ──────────────────

# HMAC key for signing web session cookies and Telegram /web handoff links.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the server generates an ephemeral key at startup and every web
# session is invalidated on restart.
WEB_SESSION_SECRET=

# Public base URL the Telegram /web command builds sign-in links against.
# Must be the address a phone browser can actually reach — localhost only
# works if you open the link on the same machine.
WEB_BASE_URL=http://localhost:8000

# Bind address for the web server.
WEB_HOST=127.0.0.1
WEB_PORT=8000
